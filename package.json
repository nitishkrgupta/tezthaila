{
  "name": "tez-thaila",
  "version": "1.0.0",
  "description": "Tez Thaila — Full-Stack Indian E-Commerce Platform",
  "private": true,
  "scripts": {
    "start": "node server/server.js",
    "build": "npm --prefix client run build",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:migrate": "npm --prefix server run prisma:migrate",
    "prisma:seed": "npm --prefix server run seed",
    "prisma:studio": "npm --prefix server run prisma:studio"
  },
  "keywords": [
    "ecommerce",
    "tez-thaila",
    "react",
    "express",
    "mysql",
    "prisma"
  ],
  "author": "Tez Thaila Team",
  "license": "MIT"
}
